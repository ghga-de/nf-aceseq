/*
    Config for the nf-test validation tests (tests/*.nf.test).
    Replaces the iGenomes/S3 references of the test profile with tiny local
    placeholder files, so the tests run offline with `-preview` (no containers,
    no processes are executed).
*/
params {
    genome          = null
    igenomes_ignore = true
    fasta           = "${projectDir}/tests/data/genome.fa"
    fai             = "${projectDir}/tests/data/genome.fa.fai"
    chrom_sizes     = "${projectDir}/tests/data/genome.sizes"
    beagle_ref      = "${projectDir}/tests/data/beagle"
    beagle_ref_ext  = "bref3"
    plink_map       = "${projectDir}/tests/data/plink"
    plink_map_ext   = "map"
}
